[
  {
    "type": "function",
    "function": {
      "name": "inspect_catalog",
      "description": "Read current ingredient names and recipe summaries from SQLite to ground interpretations and clarification options.",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "resolve_ingredient",
      "description": "Interpret a user ingredient as an equivalent catalog ingredient. Never use this for substitutions or ambiguous food types: ask the user instead. Exclusion mappings are additive.",
      "parameters": {
        "type": "object",
        "properties": {
          "ingredient": {
            "type": "string"
          },
          "catalog_name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "pantry",
              "exclusion"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "ingredient",
          "catalog_name",
          "kind",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "search_recipes",
      "description": "Find recipes in SQLite with complete cooking instructions, ingredient quantities and base servings, using user restrictions and current interpreted ingredients. Returns candidates; you decide which to recommend.",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_recipe_details",
      "description": "Inspect one recipe returned by the last search.",
      "parameters": {
        "type": "object",
        "properties": {
          "recipe_id": {
            "type": "string"
          }
        },
        "required": [
          "recipe_id"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "retrieve_guidance",
      "description": "Retrieve DASH source passages using semantic search; at most two searches.",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "ask_clarification",
      "description": "Ask a question with plausible food-type choices generated by you. Choices need not exist in the recipe catalog. Not sure is appended automatically. Never substitute an ingredient without user confirmation.",
      "parameters": {
        "type": "object",
        "properties": {
          "ingredient": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 6
          }
        },
        "required": [
          "ingredient",
          "question",
          "choices"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "finish",
      "description": "Submit verified recipe IDs and optional exact source quotes. Never invent IDs or facts.",
      "parameters": {
        "type": "object",
        "properties": {
          "recipe_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "recipe_id": {
                  "type": "string"
                },
                "guidance_id": {
                  "type": "string"
                },
                "quote": {
                  "type": "string"
                }
              },
              "required": [
                "recipe_id",
                "guidance_id",
                "quote"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "recipe_ids",
          "notes"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "list_documents",
      "description": "List ingested source PDFs and page counts from SQLite.",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "read_pdf_page",
      "description": "Read an actual PDF page using page_id from retrieved passages or source_id from recipes.",
      "parameters": {
        "type": "object",
        "properties": {
          "page_id": {
            "type": "string"
          }
        },
        "required": [
          "page_id"
        ],
        "additionalProperties": false
      }
    }
  }
]